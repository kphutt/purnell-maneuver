            "path": "/orders"
          },
          "expected": "allowed"
        },
        {
          "request": {
            "method": "DELETE",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/orders/7"
          },
          "expected": "allowed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/orders/7"
          },
          "expected": "not_listed"
        },
        {
          "request": {
            "method": "DELETE",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/orders/8"
          },
          "expected": "not_listed"
