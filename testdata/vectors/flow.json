            "scheme": "https",
            "authority": "api.example.com",
            "path": "/orders"
          },
          "expected": "not_listed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "http",
            "authority": "api.example.com",
            "path": "/orders"
          },
          "expected": "allowed"
