    },
    {
      "name": "malformed_observations_are_not_learned",
      "note": "A request the canonicalizer denies is never learned, and is denied when checked.",
      "observed": [
        {
          "method": "GET",
          "scheme": "https",
          "authority": "api.example.com",
          "path": "/a/../admin"
