{
  "format": 1,
  "about": "End-to-end cases: each case observes some raw requests, learns a caveat set from them, seals it into a token, then checks more raw requests against that token. No caveat or valid token is ever written here: the only way to a valid token is observe, learn, seal. 'bad_tokens' are hand-written malformed tokens, each checked against the request 'GET https api.example.com /orders'; none may ever be allowed. (A hand-written token that is exactly canonical is allowed today, because tokens are not signed yet; that known gap is pinned by a unit test in gate, never by a vector.) Expected values are 'allowed' or the snake_case of a gate::Denial variant.",
  "cases": [
    {
      "name": "nothing_observed_allows_nothing",
      "note": "An empty caveat set allows nothing.",
      "observed": [],
      "checks": [
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/"
          },
          "expected": "not_listed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/orders"
          },
          "expected": "not_listed"
        }
      ]
    },
    {
      "name": "observed_request_is_allowed",
      "observed": [
        {
          "method": "GET",
          "scheme": "https",
          "authority": "api.example.com",
          "path": "/orders"
        }
      ],
      "checks": [
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/orders"
          },
          "expected": "allowed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/orders?page=2"
          },
          "expected": "allowed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "HTTPS",
            "authority": "api.example.com",
            "path": "/orders"
          },
          "expected": "unsupported_scheme"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "API.example.com",
            "path": "/orders"
          },
          "expected": "malformed_host"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "API.EXAMPLE.COM",
            "path": "/orders"
          },
          "expected": "malformed_host"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com:443",
            "path": "/orders"
          },
          "expected": "malformed_port"
        }
      ],
      "note": "The query is dropped. Scheme and host case are denied, not folded, and an explicit default port is denied, not merged with no port."
    },
    {
      "name": "only_the_exact_destination",
      "note": "Paths match exactly: no prefixes, no wildcards, and a trailing slash is significant.",
      "observed": [
        {
          "method": "GET",
          "scheme": "https",
          "authority": "api.example.com",
          "path": "/orders"
        }
      ],
      "checks": [
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/orders/"
          },
          "expected": "not_listed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/orders/7"
          },
          "expected": "not_listed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/order"
          },
          "expected": "not_listed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/Orders"
          },
          "expected": "not_listed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/"
          },
          "expected": "not_listed"
        }
      ]
    },
    {
      "name": "method_is_part_of_the_destination",
      "observed": [
