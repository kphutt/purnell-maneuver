      "token": "v1;http GET https api.example.com:0443 /orders",
      "expected": "malformed_token"
    },
    {
      "name": "explicit_default_port",
      "token": "v1;http GET https api.example.com:443 /orders",
      "expected": "malformed_token"
    },
    {
      "name": "lowercase_percent_hex",
      "token": "v1;http GET https api.example.com /orders%c3%a9",
      "expected": "malformed_token"
    },
    {
      "name": "path_with_query",
      "token": "v1;http GET https api.example.com /orders?x",
      "expected": "malformed_token"
    },
    {
