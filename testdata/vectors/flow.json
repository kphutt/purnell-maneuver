      "token": "v1;http GET https api.example.com *",
      "expected": "malformed_token"
    },
    {
      "name": "repeated_caveat",
      "token": "v1;http GET https api.example.com /orders;http GET https api.example.com /orders",
      "expected": "malformed_token"
    },
    {
      "name": "unsorted_caveats",
      "token": "v1;http GET https api.example.com /z;http GET https api.example.com /orders",
      "expected": "malformed_token"
    },
    {
      "name": "unknown_kind",
      "note": "A well-formed kind tag this build does not know.",
      "token": "v1;queue orders.created",
      "expected": "unknown_caveat_kind"
    },
    {
      "name": "unknown_kind_next_to_a_match",
      "note": "A caveat of an unknown kind is never skipped: the whole token denies, even though the other caveat lists the request.",
      "token": "v1;http GET https api.example.com /orders;queue orders.created",
      "expected": "unknown_caveat_kind"
    },
    {
      "name": "mcp_kind_with_an_http_body",
      "note": "A known kind with the wrong number of fields is malformed, not an unknown kind: the kind tag is read first and it is one this build knows.",
      "token": "v1;mcp POST https mcp.example.com /mcp",
      "expected": "malformed_token"
    },
    {
      "name": "mcp_value_with_a_space",
      "note": "A space is the token's field separator, so a caveat body can never hold one; here it reads as a seventh field.",
      "token": "v1;mcp POST https mcp.example.com /mcp tools/call get document",
      "expected": "malformed_token"
    },
    {
      "name": "mcp_value_wrapped_when_it_did_not_need_to_be",
      "note": "'=?base64?Z2V0X2RvY3VtZW50?=' decodes to 'get_document', which needs no wrapping. One value may have only one spelling, so the wrapped one denies rather than folding onto the plain one.",
      "token": "v1;mcp POST https mcp.example.com /mcp tools/call =?base64?Z2V0X2RvY3VtZW50?=",
      "expected": "malformed_token"
    },
    {
      "name": "unknown_version",
      "token": "v3;http GET https api.example.com /orders",
      "expected": "unknown_version"
    },
    {
      "name": "uppercase_v2",
      "token": "V2;r-1",
      "expected": "unknown_version"
    },
    {
      "name": "v2_with_no_run_id",
      "token": "v2",
      "expected": "malformed_run_id",
      "note": "v2 always names a run, so this is a token missing its id, not an empty-set token."
    },
    {
      "name": "v2_with_an_empty_run_id",
      "token": "v2;;http GET https api.example.com /orders",
      "expected": "malformed_run_id"
    },
    {
      "name": "v2_run_id_with_a_space",
      "token": "v2;r 1;http GET https api.example.com /orders",
      "expected": "malformed_run_id"
    },
    {
      "name": "v2_run_id_with_a_dot",
      "token": "v2;r.1;http GET https api.example.com /orders",
      "expected": "malformed_run_id"
    },
    {
      "name": "v2_run_id_over_the_limit",
      "token": "v2;aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa;http GET https api.example.com /orders",
      "expected": "malformed_run_id",
      "note": "65 bytes; the limit is 64."
    },
    {
      "name": "v2_gets_no_leniency_from_its_run_id",
      "token": "v2;r-1;http GET https API.example.com /orders",
      "expected": "malformed_token",
      "note": "Every caveat rule holds unchanged under v2: the run id buys a caveat nothing."
    },
    {
      "name": "v2_repeated_caveat",
      "token": "v2;r-1;http GET https api.example.com /orders;http GET https api.example.com /orders",
      "expected": "malformed_token"
    },
    {
      "name": "v2_unknown_kind",
      "token": "v2;r-1;queue orders.created",
      "expected": "unknown_caveat_kind"
    }
