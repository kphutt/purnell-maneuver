  "bad_tokens": [
    {
      "name": "empty",
      "token": "",
      "expected": "empty_token"
    },
    {
      "name": "unknown_version",
      "token": "v2;http GET https api.example.com /orders",
      "expected": "unknown_version"
    },
    {
      "name": "no_version",
      "token": "http GET https api.example.com /orders",
      "expected": "unknown_version"
    },
    {
      "name": "uppercase_version",
      "token": "V1",
      "expected": "unknown_version"
    },
    {
      "name": "trailing_separator",
      "token": "v1;",
      "expected": "malformed_token"
    },
    {
      "name": "missing_kind",
      "token": "v1;GET https api.example.com /orders",
      "expected": "malformed_token"
    },
    {
      "name": "old_layout_without_kind",
      "token": "v1;GET https api.example.com 443 /orders",
      "expected": "malformed_token"
    },
    {
      "name": "missing_field",
      "token": "v1;http GET https api.example.com",
      "expected": "malformed_token"
    },
    {
      "name": "extra_field",
      "token": "v1;http GET https api.example.com /orders x",
      "expected": "malformed_token"
    },
    {
      "name": "not_canonical_kind",
      "token": "v1;HTTP GET https api.example.com /orders",
      "expected": "malformed_token"
    },
    {
      "name": "not_canonical_scheme",
      "token": "v1;http GET HTTPS api.example.com /orders",
      "expected": "malformed_token"
    },
    {
      "name": "not_canonical_host",
      "token": "v1;http GET https API.example.com /orders",
      "expected": "malformed_token"
    },
    {
      "name": "not_canonical_port",
      "token": "v1;http GET https api.example.com:0443 /orders",
      "expected": "malformed_token"
    },
    {
      "name": "explicit_default_port",
      "token": "v1;http GET https api.example.com:443 /orders",
      "expected": "malformed_token"
    },
    {
      "name": "lowercase_percent_hex",
      "token": "v1;http GET https api.example.com /orders%c3%a9",
      "expected": "malformed_token"
    },
    {
      "name": "path_with_query",
      "token": "v1;http GET https api.example.com /orders?x",
      "expected": "malformed_token"
    },
    {
      "name": "wildcard_is_just_a_bad_path",
      "token": "v1;http GET https api.example.com *",
      "expected": "malformed_token"
    },
    {
      "name": "repeated_caveat",
      "token": "v1;http GET https api.example.com /orders;http GET https api.example.com /orders",
      "expected": "malformed_token"
    },
    {
      "name": "unsorted_caveats",
      "token": "v1;http GET https api.example.com /z;http GET https api.example.com /orders",
      "expected": "malformed_token"
    },
    {
      "name": "unknown_kind",
      "token": "v1;mcp tools/call search",
      "expected": "unknown_caveat_kind"
    },
    {
      "name": "unknown_kind_next_to_a_match",
      "note": "A caveat of an unknown kind is never skipped: the whole token denies, even though the other caveat lists the request.",
      "token": "v1;http GET https api.example.com /orders;mcp tools/call search",
      "expected": "unknown_caveat_kind"
    }
  ]
}
