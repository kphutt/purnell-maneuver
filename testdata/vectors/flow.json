            "scheme": "https",
            "authority": "api.example.com:8443",
            "path": "/orders"
          },
          "expected": "not_listed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "example.com",
            "path": "/orders"
          },
          "expected": "not_listed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com.evil.test",
            "path": "/orders"
