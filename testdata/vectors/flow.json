    {
      "name": "unicode_is_bytes",
      "note": "NFC and NFD spellings are different destinations, and lowercase percent-hex is denied rather than folded to uppercase.",
      "observed": [
        {
          "method": "GET",
          "scheme": "https",
          "authority": "api.example.com",
          "path": "/caf%C3%A9"
        }
      ],
      "checks": [
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/caf%c3%a9"
          },
          "expected": "malformed_path"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/cafe%CC%81"
          },
          "expected": "not_listed"
        }
      ]
    },
    {
      "name": "numeric_hosts_have_one_spelling",
      "note": "A host that ends in a number must be a dotted quad: browsers and resolvers read 127.1, 0x7f.0.0.1 and 2130706433 as 127.0.0.1, so each is denied, never matched. An IPv6 literal must be in RFC 5952 form.",
      "observed": [
        {
          "method": "GET",
          "scheme": "https",
          "authority": "127.0.0.1",
          "path": "/health"
        },
        {
          "method": "GET",
          "scheme": "https",
          "authority": "[::1]",
          "path": "/health"
        }
      ],
      "checks": [
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "127.0.0.1",
            "path": "/health"
          },
          "expected": "allowed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "127.1",
            "path": "/health"
          },
          "expected": "malformed_host"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "0x7f.0.0.1",
            "path": "/health"
          },
          "expected": "malformed_host"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "2130706433",
            "path": "/health"
          },
          "expected": "malformed_host"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "127.0.0.01",
            "path": "/health"
          },
          "expected": "malformed_host"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "[::1]",
            "path": "/health"
          },
          "expected": "allowed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "[0::1]",
            "path": "/health"
          },
          "expected": "malformed_host"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "[0:0:0:0:0:0:0:1]",
            "path": "/health"
          },
          "expected": "malformed_host"
        }
      ]
    },
    {
