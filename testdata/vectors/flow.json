            "scheme": "https",
            "authority": "api.example.com",
            "path": "/"
          },
          "expected": "not_listed"
        },
        {
          "request": {
            "method": "GET",
            "scheme": "https",
            "authority": "api.example.com",
            "path": "/orders"
          },
          "expected": "not_listed"
