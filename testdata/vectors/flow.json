      "token": "v1;HTTP GET https api.example.com /orders",
      "expected": "malformed_token"
    },
    {
      "name": "not_canonical_scheme",
      "token": "v1;http GET HTTPS api.example.com /orders",
      "expected": "malformed_token"
    },
    {
