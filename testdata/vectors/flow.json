  "bad_tokens": [
    {
      "name": "empty",
      "token": "",
      "expected": "empty_token"
    },
    {
      "name": "v2_body_read_as_a_run_id",
      "token": "v2;http GET https api.example.com /orders",
      "expected": "malformed_run_id",
      "note": "v2 names a run before its caveats, so this token's first piece is read as a run id and denied for the space in it -- never as a caveat."
    },
    {
      "name": "no_version",
      "token": "http GET https api.example.com /orders",
      "expected": "unknown_version"
    },
    {
      "name": "uppercase_version",
      "token": "V1",
      "expected": "unknown_version"
    },
    {
      "name": "trailing_separator",
      "token": "v1;",
      "expected": "malformed_token"
    },
    {
      "name": "missing_kind",
      "token": "v1;GET https api.example.com /orders",
      "expected": "malformed_token"
    },
    {
      "name": "old_layout_without_kind",
      "token": "v1;GET https api.example.com 443 /orders",
      "expected": "malformed_token"
    },
    {
